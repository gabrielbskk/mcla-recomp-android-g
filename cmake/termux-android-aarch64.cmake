# Recovered from the historical Termux toolchain; paths are now explicit inputs.
# This parameterized copy has not yet completed a fresh Android build.
# MCLA_NDK_SYSROOT: the NDK prebuilt sysroot directory (headers/libraries only).
# PREFIX: the Termux installation prefix containing native ARM64 clang/clang++.
if(NOT IS_DIRECTORY "$ENV{MCLA_NDK_SYSROOT}")
  message(FATAL_ERROR "Set MCLA_NDK_SYSROOT to the Android NDK sysroot")
endif()
if(NOT EXISTS "$ENV{PREFIX}/bin/clang++")
  message(FATAL_ERROR "PREFIX must identify Termux with native clang++ installed")
endif()
set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_SYSTEM_VERSION 26)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_ANDROID_ARCH_ABI arm64-v8a)
set(CMAKE_ANDROID_STL_TYPE c++_shared)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(NDK_SYSROOT "$ENV{MCLA_NDK_SYSROOT}")
set(CMAKE_SYSROOT "${NDK_SYSROOT}")
set(CMAKE_C_COMPILER "$ENV{PREFIX}/bin/clang")
set(CMAKE_CXX_COMPILER "$ENV{PREFIX}/bin/clang++")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-android26)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-android26)
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++ -nostdinc++ -isystem ${NDK_SYSROOT}/usr/include/c++/v1")
set(_MCLA_ANDROID_LINK_FLAGS "-L${NDK_SYSROOT}/usr/lib/aarch64-linux-android/26")
if(IS_DIRECTORY "$ENV{MCLA_LIBUNWIND_DIR}")
  list(APPEND _MCLA_ANDROID_LINK_FLAGS "-L$ENV{MCLA_LIBUNWIND_DIR}")
endif()
string(JOIN " " _MCLA_ANDROID_LINK_FLAGS_STRING ${_MCLA_ANDROID_LINK_FLAGS})
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_MCLA_ANDROID_LINK_FLAGS_STRING}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_MCLA_ANDROID_LINK_FLAGS_STRING}")
# Android bionic provides pthreads in libc; never probe or link the host
# Termux `pthreads` archive while cross-compiling.
set(THREADS_PREFER_PTHREAD_FLAG ON CACHE BOOL "" FORCE)
set(CMAKE_THREAD_LIBS_INIT "-pthread" CACHE STRING "" FORCE)
set(CMAKE_USE_PTHREADS_INIT 1 CACHE INTERNAL "" FORCE)
set(CMAKE_FIND_ROOT_PATH "${NDK_SYSROOT}" "$ENV{PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
